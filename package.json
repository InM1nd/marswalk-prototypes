{
  "name": "marswalk-prototypes",
  "private": true,
  "scripts": {
    "build": "node scripts/build-all.mjs",
    "dev": "concurrently -n hub,wheel,scratch,runner,plinko -c cyan,yellow,green,magenta,red \"npm:dev:hub\" \"npm:dev:wheel\" \"npm:dev:scratch\" \"npm:dev:runner\" \"npm:dev:plinko\"",
    "dev:hub": "node scripts/dev-server.mjs",
    "dev:wheel": "VITE_BASE_PATH=/wheel/ npm --prefix apps/wheel run dev",
    "dev:scratch": "VITE_BASE_PATH=/scratch/ npm --prefix apps/scratch run dev -- --port 5174",
    "dev:runner": "VITE_BASE_PATH=/runner/ npm --prefix apps/runner run dev -- --port 5175",
    "dev:plinko": "VITE_BASE_PATH=/plinko/ npm --prefix apps/plinko run dev -- --port 5176"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "http-proxy": "^1.18.1"
  }
}
