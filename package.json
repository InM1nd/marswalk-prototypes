{
  "name": "marswalk-prototypes",
  "private": true,
  "scripts": {
    "build": "node scripts/build-all.mjs",
    "dev": "concurrently -n hub,wheel,scratch -c cyan,yellow,green \"npm:dev:hub\" \"npm:dev:wheel\" \"npm:dev:scratch\"",
    "dev:hub": "node scripts/dev-server.mjs",
    "dev:wheel": "VITE_BASE_PATH=/wheel/ npm --prefix apps/wheel run dev",
    "dev:scratch": "VITE_BASE_PATH=/scratch/ npm --prefix apps/scratch run dev -- --port 5174"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "http-proxy": "^1.18.1"
  }
}
